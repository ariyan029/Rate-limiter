# Application Server Configuration
PORT=3000

# Redis NoSQL Database Configuration
REDIS_URL=redis://localhost:6379

# Rate Limiter Algorithm Settings (Fixed Window Counter)
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=5

# Fault Tolerance Strategy
# false = Fail-closed (HTTP 503 if Redis is unreachable, protecting downstream services)
# true  = Fail-open (Allow request with warning header, prioritizing service availability)
RATE_LIMIT_FAIL_OPEN=false
